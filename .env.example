# Copie para .env para rodar local (npm run dev). No Railway, estas variáveis
# ficam nas settings do serviço — o .env nunca vai para o repositório.

# Postgres. Local: o banco criado com `createdb avaliacoes_teste`.
DATABASE_URL=postgres://localhost/avaliacoes_teste

# Segredo que assina os logins. Qualquer texto longo e aleatório:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Endereço público que vai DENTRO do QR code (sem barra no fim).
# Vazio = usa o endereço pelo qual o painel foi aberto.
URL_PUBLICA=

# Só `true` depois que URL_PUBLICA for o domínio definitivo. Enquanto não for,
# todo PNG de QR sai com a faixa "TESTE — NÃO IMPRIMIR".
QR_DEFINITIVO=false

PORT=8081
